<?xml version="1.0" encoding="UTF-8"?>
<!--
  日志配置：控制台 + 按天滚动 JSON Lines 文件。
  - 当天日志写入 ${LOG_PATH}/yyyy-MM-dd/${appName}.log。
  - error 级别额外单独落一份按天滚动文件，便于排查 500 等系统异常。
  - 输出字段与 Python 端日志追踪约定对齐：time / level / service / host / pid / trace_id / logger_name / message / exception。
  - 日志级别仍由 application.yml 的 logging.level 控制（Spring Boot 在此基础上叠加生效）。
  - 日志目录可用环境变量 LOG_PATH 覆盖（默认 logs）。
-->
<configuration>

    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="tolink-service"/>
    <property name="LOG_PATH" value="${LOG_PATH:-logs}"/>

    <!-- 控制台 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <fieldNames>
                <timestamp>time</timestamp>
                <version>[ignore]</version>
                <level>level</level>
                <levelValue>[ignore]</levelValue>
                <logger>logger_name</logger>
                <thread>[ignore]</thread>
                <message>message</message>
                <stackTrace>exception</stackTrace>
            </fieldNames>
            <includeContext>false</includeContext>
            <includeMdcKeyName>trace_id</includeMdcKeyName>
            <customFields>{"service":"${appName}","host":"${HOSTNAME:-unknown}","pid":"${PID:-}"}</customFields>
        </encoder>
    </appender>

    <!-- 全量日志：每天一个日期文件夹，当天日志写入当天文件夹 -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/%d{yyyy-MM-dd}/${appName}.log</fileNamePattern>
            <maxHistory>7</maxHistory>
            <totalSizeCap>5GB</totalSizeCap>
            <cleanHistoryOnStart>false</cleanHistoryOnStart>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <fieldNames>
                <timestamp>time</timestamp>
                <version>[ignore]</version>
                <level>level</level>
                <levelValue>[ignore]</levelValue>
                <logger>logger_name</logger>
                <thread>[ignore]</thread>
                <message>message</message>
                <stackTrace>exception</stackTrace>
            </fieldNames>
            <includeContext>false</includeContext>
            <includeMdcKeyName>trace_id</includeMdcKeyName>
            <customFields>{"service":"${appName}","host":"${HOSTNAME:-unknown}","pid":"${PID:-}"}</customFields>
        </encoder>
    </appender>

    <!-- 仅 error 日志：每天一个日期文件夹，当天 error 写入当天文件夹 -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/%d{yyyy-MM-dd}/${appName}-error.log</fileNamePattern>
            <maxHistory>7</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <fieldNames>
                <timestamp>time</timestamp>
                <version>[ignore]</version>
                <level>level</level>
                <levelValue>[ignore]</levelValue>
                <logger>logger_name</logger>
                <thread>[ignore]</thread>
                <message>message</message>
                <stackTrace>exception</stackTrace>
            </fieldNames>
            <includeContext>false</includeContext>
            <includeMdcKeyName>trace_id</includeMdcKeyName>
            <customFields>{"service":"${appName}","host":"${HOSTNAME:-unknown}","pid":"${PID:-}"}</customFields>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </root>

</configuration>
